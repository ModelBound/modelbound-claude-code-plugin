{
  "SessionStart": [
    {
      "matcher": "*",
      "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js",
      "description": "ModelBound: warn on rule drift, optionally auto-sync"
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "pathPattern": ".claude/**",
      "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/post-edit-sync.js",
      "description": "ModelBound: auto-push edits under .claude/ back to team library"
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/backup.js ${ARGUMENTS}",
      "description": "ModelBound: pre-edit backup to .mb-backup/"
    },
    {
      "matcher": "Bash",
      "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/guard-bash.js",
      "description": "ModelBound: block denylisted bash patterns (rm -rf, curl | sh, etc.)"
    },
    {
      "matcher": "WebFetch",
      "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/guard-webfetch.js",
      "description": "ModelBound: block private IPs and non-allow-listed domains"
    }
  ]
}
