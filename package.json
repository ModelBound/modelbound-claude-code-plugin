    "dev": "tsup scripts/*.ts --format esm --target node20 --out-dir dist --watch"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
